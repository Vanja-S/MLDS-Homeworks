\@writefile{toc}{\contentsline {section}{\numberline {1}LIME on \texttt  {toydataset.csv}}{1}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces LIME explanations of the four query points. Coefficients $\beta _j$ are those of the weighted Lasso on the binary $z$. The instance has $z = (1, 1, 1)$ by construction, so $g(x) = \beta _0 + \DOTSB \sum@ \slimits@ _j \beta _j$.}}{1}{}\protected@file@percent }
\newlabel{tab:lime}{{1}{1}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Top: $y$ vs.\ $(x_1, x_2)$ split by $x_3$, full data set. Bottom: LIME bar plots, blue $= +$, red $= -$. Each panel shows the black-box prediction $f(x)$, the surrogate prediction $g(x)$, and the kernel-weighted local $R^2$ of the surrogate.}}{2}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Shapley values}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Shapley values $\varphi _j(x)$ for the four query points. Each title shows $f(x)$, the baseline $\mathbb  E[f] = 1.50$, and $\DOTSB \sum@ \slimits@ _j \varphi _j$. By the efficiency axiom $f(x) - \mathbb  E[f] = \DOTSB \sum@ \slimits@ _j \varphi _j$ exactly, and indeed every panel satisfies this to numerical precision.}}{3}{}\protected@file@percent }
\newlabel{fig:shap}{{2}{3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Exact Shapley values under feature independence, $\mathbb  E[f] = 1.499$. The right-most column verifies the efficiency axiom $\DOTSB \sum@ \slimits@ _j \varphi _j = f(x) - \mathbb  E[f]$ (to numerical precision).}}{3}{}\protected@file@percent }
\newlabel{tab:shap}{{2}{3}{}{}{}}
